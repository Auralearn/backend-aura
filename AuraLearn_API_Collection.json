            "host": [
              "{{baseUrl}}"
            ],
            "path": [
              "{{apiPrefix}}",
              "interact"
            ]
          },
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"user_text\": \"buka pdf scanner\",\n  \"current_context\": {\n    \"active_material_id\": null,\n    \"active_chapter_id\": null\n  }\n}"
          },
          "description": "Tests a navigation interaction that should trigger opening the PDF scanner"
