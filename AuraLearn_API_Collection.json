      {
        "name": "Interact - Unrecognized Command",
        "request": {
          "method": "POST",
          "url": {
            "raw": "http://{{baseUrl}}{{apiPrefix}}/interact",
            "protocol": "http",
            "host": [
              "{{baseUrl}}"
            ],
            "path": [
              "{{apiPrefix}}",
              "interact"
            ]
          },
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": {
            "mode": "raw",
            "raw": "{\n  \"user_text\": \"random text that doesn't match any pattern\",\n  \"current_context\": {\n    \"active_material_id\": null,\n    \"active_chapter_id\": null\n  }\n}"
          },
          "description": "Tests handling of an unrecognized command"
        },
        "response": []
      }
    ],
    "variable": [
      {
        "key": "baseUrl",
        "value": "localhost:8000",
        "type": "string"
      },
      {
        "key": "apiPrefix",
        "value": "/api/v1",
        "type": "string"
      }
    ],
    "event": [
      {
        "listen": "prerequest",
        "script": {
          "type": "text/javascript",
          "exec": [
            ""
          ]
        }
      },
      {
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test(\"Status code is 200\", function () {",
            "    pm.response.to.have.status(200);",
            "});",
            "",
            "pm.test(\"Response structure is valid\", function () {",
            "    const responseData = pm.response.json();",
            "    pm.expect(responseData).to.be.an('object');",
            "    pm.expect(responseData).to.have.property('success');",
            "    ",
            "    if (responseData.success) {",
            "        pm.expect(responseData).to.have.property('data');",
            "    } else {",
            "        pm.expect(responseData).to.have.property('error');",
            "        pm.expect(responseData.error).to.have.property('code');",
            "        pm.expect(responseData.error).to.have.property('message');",
            "    }",
            "});"
          ]
        }
      }
    ]
  }